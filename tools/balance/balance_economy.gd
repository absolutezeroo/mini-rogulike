class_name BalanceEconomy
extends Node
## The economy, measured on real floors (BalanceLab): for every normal depth of the four acts
## and each difficulty, floors are generated by the game (its own events, curses, merchants,
## chests...) and harvested by the game's own code: every monster slain by the hero (and what
## they release), every crate broken, every chest opened; the gold, XP, items (by rarity) and
## runes that come out are counted. A merchant is set on the floor to read real stock prices.
## Ambushes and encounters are counted and valued from their data.
## From there: gold per floor vs shop prices, rerolls and forge costs; XP per floor -> the level
## at each boss (the expected builds' reasoning); loot rarity per depth; souls per run (by result
## and difficulty) vs the shrine's costs.

## Floors generated per depth and difficulty (different seeds).
const SEEDS := 2
## Share of a floor's monsters a typical player slays (the seal asks seal_share; most do a bit
## more): per act, as the expected builds assume.
const KILL_SHARE := [0.8, 0.75, 0.65, 0.6]
## Merchant samples per floor (their stock is rolled again each time).
const SHOP_SAMPLES := 4

var lab: BalanceLab
var content: ContentDB
var targets: BalanceTargets
var all_builds: Array[BalanceBuildDef] = []
var difficulties: Array[DifficultyDef] = []
var seed_value := 1
var quick := false
var verbose := true


func run() -> BalanceReport:
	var report := BalanceReport.new()
	report.title = "Balance economy"
	var started := Time.get_ticks_msec()
	lab.restore_chances()
	var floors: Array = []
	var depths: Array[int] = []
	for depth in range(1, content.dungeon.total_floors() + 1):
		if content.dungeon.boss_for_depth(depth) == null:
			depths.append(depth)
	if quick:
		depths = depths.slice(0, 2)
	var d_list := difficulties if not quick else difficulties.slice(0, 1)
	for difficulty in d_list:
		for depth in depths:
			for i in (SEEDS if not quick else 1):
				var f := await harvest(depth, difficulty, seed_value * 7919 + depth * 31 + i)
				floors.append(f)
		if verbose:
			print("  economy: %s done (%d floors)" % [BalanceContent.key(difficulty), floors.size()])
	var per_depth := _per_depth(floors)
	_floor_table(report, per_depth)
	_shop_table(report, per_depth)
	_levels_table(report, per_depth)
	_loot_table(report)
	_souls_table(report, per_depth)
	var seconds := (Time.get_ticks_msec() - started) / 1000.0
	report.notes.append("Economy: %d floors generated and harvested in %.0f s of real time (seed %d)." % [floors.size(), seconds, seed_value])
	report.timings["economy"] = seconds
	report.data["floors"] = floors
	report.data["per_depth"] = per_depth
	return report


## One real floor, everything taken: { depth, difficulty, monsters, ranked, props, chests, gold_*, xp, items, runes, ... }.
func harvest(depth: int, difficulty: DifficultyDef, floor_seed: int) -> Dictionary:
	var game := await lab.start_game(depth, difficulty, null, false, null, floor_seed)
	var world := game.world
	var player := game.player
	player.invincible = true
	player.gold = 0
	var result := { "depth": depth, "difficulty": BalanceContent.key(difficulty), "seed": floor_seed,
		"event": String(world.floor_event.id) if world.floor_event else "", "curse": String(world.curse.id) if world.curse else "",
		"merchant": not get_tree().get_nodes_in_group("merchants").filter(func(n: Node) -> bool: return n.is_inside_tree()).is_empty(),
		"forge": not get_tree().get_nodes_in_group("forges").is_empty(),
		"encounters": get_tree().get_nodes_in_group("encounters").map(func(n: Node) -> String: return String((n as Encounter).def.id)),
		"ambush": world.ambush != null }
	await get_tree().physics_frame
	# Monsters (and what they release: splits, trapped chests...).
	var xp := 0
	var kills := 0
	var ranked := {}
	var first_count := world.get_hostiles(player.faction).size()
	var gold_before := _gold_on_floor()
	for round_index in 6:
		var hostiles := world.get_hostiles(player.faction)
		if hostiles.is_empty():
			break
		for actor in hostiles:
			var monster := actor as Monster
			if monster == null or monster.is_dead:
				continue
			if not monster.summoned:
				xp += monster.def.xp_reward * monster._xp_multiplier
				kills += 1
				if monster.rank:
					ranked[String(monster.rank.id)] = int(ranked.get(String(monster.rank.id), 0)) + 1
			monster.die(player)
		for i in 3:
			await get_tree().physics_frame
	for i in 3:
		await get_tree().physics_frame
	var gold_monsters := _gold_on_floor() - gold_before
	# Crates, pots, barrels.
	var props := 0
	gold_before = _gold_on_floor()
	for prop in world.get_breakable_props():
		props += 1
		prop._break()
	for i in 3:
		await get_tree().physics_frame
	var gold_props := _gold_on_floor() - gold_before
	# Chests (trapped ones may release monsters: slain too, their gold counted with the chests).
	var chests := 0
	gold_before = _gold_on_floor()
	for node in get_tree().get_nodes_in_group("chests"):
		var chest := node as Chest
		if chest and not chest.is_open and chest.is_inside_tree():
			chests += 1
			chest.open()
	for i in 3:
		await get_tree().physics_frame
	for actor in world.get_hostiles(player.faction):
		var monster := actor as Monster
		if monster and not monster.is_dead:
			monster.die(player)
	for i in 4:
		await get_tree().physics_frame
	var gold_chests := _gold_on_floor() - gold_before
	# What lies on the floor now: items by rarity, runes.
	var rarities := [0, 0, 0, 0]
	var runes := 0
	var consumables := 0
	for node in get_tree().get_nodes_in_group("pickups"):
		var pickup := node as ItemPickup
		if pickup == null or not pickup.is_inside_tree() or pickup.item == null:
			continue
		if pickup.item is RuneDef:
			runes += 1
		elif pickup.item is EquipmentDef:
			rarities[clampi((pickup.item as EquipmentDef).rarity, 0, 3)] += 1
		else:
			consumables += 1
	# The ambush (not triggered): its waves and big chest from the data.
	var ambush_gold := 0.0
	var ambush_kills := 0
	if world.ambush:
		var config := content.dungeon
		ambush_kills = config.ambush_waves * (config.ambush_wave_size + floori(depth / 3.0))
		ambush_gold = ambush_kills * _kill_gold(depth, 1.0) * config.gold_drop_chance + _kill_gold(depth, config.elite_rank.gold_multiplier)
		if config.ambush_chest:
			ambush_gold += (config.ambush_chest.gold.x + config.ambush_chest.gold.y) * 0.5 + depth * config.ambush_chest.gold_per_depth
		ambush_gold = world.rules.gold(ambush_gold)
	# Shop prices (a merchant set on this floor, its stock rolled SHOP_SAMPLES times).
	var prices: Array = []
	var equipment_prices: Array = []
	var reroll := 0
	if content.dungeon.merchant:
		for k in SHOP_SAMPLES:
			var merchant := world.spawn_merchant(content.dungeon.merchant, world.map.start_cell)
			for entry: Dictionary in merchant.stock:
				prices.append(float(entry.price))
				if entry.item is EquipmentDef:
					equipment_prices.append(float(entry.price))
			reroll = merchant.reroll_price()
			merchant.remove_from_group("merchants")
			merchant.queue_free()
	var removal := content.dungeon.forge.removal_cost(depth, world.rules.shop_prices()) if content.dungeon.forge else 0
	result.merge({
		"monsters": first_count, "kills": kills, "ranked": ranked, "xp": xp, "props": props, "chests": chests,
		"gold_monsters": gold_monsters, "gold_props": gold_props, "gold_chests": gold_chests, "gold_ambush": ambush_gold,
		"ambush_kills": ambush_kills, "items": rarities, "runes": runes, "consumables": consumables,
		"price_mean": BalanceContent.mean(prices), "price_equipment": BalanceContent.mean(equipment_prices), "reroll": reroll, "forge_removal": removal,
	})
	player.invincible = false
	await lab.end_game(game)
	return result


func _gold_on_floor() -> int:
	var total := 0
	for node in get_tree().get_nodes_in_group("gold"):
		var coin := node as GoldPickup
		if coin and not coin.is_queued_for_deletion():
			total += coin.amount
	return total


## Average gold of one kill at `depth` (DungeonConfig.gold_for_kill), before the drop chance.
func _kill_gold(depth: int, multiplier: float) -> float:
	var config := content.dungeon
	return ((config.gold_per_kill.x + config.gold_per_kill.y) * 0.5 + config.gold_per_depth * (depth - 1)) * multiplier


## The floors averaged per (difficulty, depth).
func _per_depth(floors: Array) -> Array:
	var groups := {}
	for f: Dictionary in floors:
		var key := "%s|%d" % [f.difficulty, f.depth]
		if not groups.has(key):
			groups[key] = []
		groups[key].append(f)
	var result: Array = []
	for key: String in groups:
		var list: Array = groups[key]
		var first: Dictionary = list[0]
		var act := content.dungeon.act_index(first.depth) + 1
		var share: float = KILL_SHARE[clampi(act - 1, 0, KILL_SHARE.size() - 1)]
		var avg := func(field: String) -> float:
			return BalanceContent.mean(list.map(func(f: Dictionary) -> float: return float(f[field])))
		var monsters_gold: float = avg.call("gold_monsters")
		var full: float = monsters_gold + avg.call("gold_props") + avg.call("gold_chests") + avg.call("gold_ambush")
		var typical: float = monsters_gold * share + avg.call("gold_props") * 0.6 + avg.call("gold_chests") + avg.call("gold_ambush") * 0.5
		var items := [0.0, 0.0, 0.0, 0.0]
		for f: Dictionary in list:
			for r in 4:
				items[r] += float(f.items[r]) / list.size()
		result.append({
			"difficulty": first.difficulty, "depth": first.depth, "act": act, "floors": list.size(),
			"monsters": avg.call("monsters"), "kills": avg.call("kills"), "xp": avg.call("xp"), "xp_typical": avg.call("xp") * share,
			"kills_typical": avg.call("kills") * share, "props": avg.call("props"), "chests": avg.call("chests"),
			"gold_monsters": monsters_gold, "gold_props": avg.call("gold_props"), "gold_chests": avg.call("gold_chests"),
			"gold_ambush": avg.call("gold_ambush"), "gold_full": full, "gold_typical": typical, "items": items,
			"runes": avg.call("runes"), "price_mean": avg.call("price_mean"), "price_equipment": avg.call("price_equipment"),
			"reroll": avg.call("reroll"), "forge_removal": avg.call("forge_removal"),
			"events": list.map(func(f: Dictionary) -> String: return f.event if f.event != "" else (("curse " + f.curse) if f.curse != "" else "-")),
			"merchants": list.filter(func(f: Dictionary) -> bool: return f.merchant).size(),
		})
	result.sort_custom(func(a: Dictionary, b: Dictionary) -> bool:
		var ra := BalanceContent.rank_of(a.difficulty)
		var rb := BalanceContent.rank_of(b.difficulty)
		return a.depth < b.depth if ra == rb else ra < rb)
	return result


func _floor_table(report: BalanceReport, per_depth: Array) -> void:
	var rows: Array = []
	for p: Dictionary in per_depth:
		rows.append([p.difficulty, p.depth, p.act, p.monsters, p.chests, p.props, p.gold_monsters, p.gold_props, p.gold_chests, p.gold_ambush,
			p.gold_full, p.gold_typical, p.xp, "%.1f/%.1f/%.1f/%.1f" % p.items, p.runes, ", ".join(p.events)])
	report.table("economy_floors", "Economy", "Gold, XP and loot per floor, measured (floors generated by the game, everything slain/broken/opened by its own code; %d seeds each). Typical = %s of the monsters (acts I-IV), 60%% of the crates, every chest, half the ambushes" % [SEEDS, "/".join(KILL_SHARE.map(func(k: float) -> String: return "%d%%" % roundi(k * 100.0)))],
		PackedStringArray(["Difficulty", "Depth", "Act", "Monsters", "Chests", "Crates", "Gold: monsters", "crates", "chests", "ambush (est.)", "Gold full clear", "Gold typical", "XP (all)", "Items C/M/R/E", "Runes", "Events"]), rows)


func _shop_table(report: BalanceReport, per_depth: Array) -> void:
	var rows: Array = []
	var floors_between := 1.0 / maxf(content.dungeon.merchant_chance, 0.01)
	for p: Dictionary in per_depth:
		var per_visit: float = p.gold_typical * floors_between
		var items_per_visit: float = per_visit / maxf(p.price_mean, 1.0)
		var reroll_share: float = p.reroll / maxf(p.gold_typical, 1.0)
		var forge_share: float = p.forge_removal / maxf(p.gold_typical, 1.0)
		rows.append([p.difficulty, p.depth, p.gold_typical, p.price_mean, p.price_equipment, "%.2f" % items_per_visit, p.reroll, BalanceReport.pct(reroll_share),
			p.forge_removal, BalanceReport.pct(forge_share)])
		if p.difficulty != "normal" and p.difficulty != "hard":
			continue
		var subject := "depth %d (%s)" % [p.depth, p.difficulty]
		if items_per_visit < targets.gold_per_visit_items_min or items_per_visit > targets.gold_per_visit_items_max:
			report.flag(BalanceReport.WARN, "economy: shop", subject, "%.2f items per visit" % items_per_visit,
				"%.1f-%.1f" % [targets.gold_per_visit_items_min, targets.gold_per_visit_items_max],
				"%.0f gold between merchants (%.1f floors) vs %.0f gold an item" % [per_visit, floors_between, p.price_mean])
		if reroll_share > targets.reroll_floor_share_max:
			report.flag(BalanceReport.WARN, "economy: reroll", subject, BalanceReport.pct(reroll_share), "<= %s" % BalanceReport.pct(targets.reroll_floor_share_max),
				"first reroll %d gold vs %.0f gold a floor" % [p.reroll, p.gold_typical])
		if forge_share > targets.forge_floor_share_max:
			report.flag(BalanceReport.WARN, "economy: forge", subject, BalanceReport.pct(forge_share), "<= %s" % BalanceReport.pct(targets.forge_floor_share_max),
				"rune removal %d gold vs %.0f gold a floor" % [p.forge_removal, p.gold_typical])
	report.table("economy_shop", "Economy", "Gold vs prices (merchant stock measured on each floor; a merchant every %.1f floors on average): items a typical visit buys, first reroll and rune removal vs a floor's gold" % floors_between,
		PackedStringArray(["Difficulty", "Depth", "Gold/floor (typical)", "Avg stock price", "Avg equipment price", "Items per visit", "Reroll", "Reroll / floor gold", "Rune removal", "Removal / floor gold"]), rows)
	# Encounters that cost or give gold.
	var enc_rows: Array = []
	for encounter in content.encounters:
		for choice in encounter.choices:
			var chances := choice.chances()
			var gold_back := 0.0
			var items := 0.0
			for i in choice.outcomes.size():
				gold_back += chances[i] * choice.outcomes[i].gold
				if choice.outcomes[i].item_quality > 0.0:
					items += chances[i]
			for depth in [2, 5, 8, 11]:
				enc_rows.append([String(encounter.id), choice.label, depth, choice.cost_in_gold(depth), gold_back, "%.2f" % items,
					BalanceReport.pct(choice.max_hp_cost) if choice.max_hp_cost > 0.0 else "-"])
	report.table("economy_encounters", "Economy", "Encounters: what each choice costs and gives back in gold and items (from the data)",
		PackedStringArray(["Encounter", "Choice", "Depth", "Gold cost", "Gold back (avg)", "Items (avg)", "Max health cost"]), enc_rows)


## XP per floor -> the hero's level at each boss (the expected builds' reasoning).
func _levels_table(report: BalanceReport, per_depth: Array) -> void:
	var rows: Array = []
	var def := content.player
	for difficulty in difficulties:
		var d_key := BalanceContent.key(difficulty)
		var xp := 0.0
		var complete := true
		for act in range(1, content.dungeon.acts.size() + 1):
			var measured := 0
			for p: Dictionary in per_depth:
				if p.difficulty == d_key and p.act == act:
					xp += p.xp_typical
					measured += 1
			complete = complete and measured >= content.dungeon.acts[act - 1].floors - 1
			var level := _level_for(xp)
			var build := BalanceBuild.expected(all_builds, act)
			rows.append([d_key, act, roundi(xp), level, build.level if build else "-", BalanceReport.pct(KILL_SHARE[act - 1])])
			if build and complete and d_key == "normal" and absi(level - build.level) >= 2:
				report.flag(BalanceReport.WARN, "economy: build level", "%s (act %d)" % [build.name, act], "level %d in the build" % build.level,
					"level %d measured" % level, "XP before the act's boss on Normal (%d, %s of the monsters): update the expected build" % [roundi(xp), BalanceReport.pct(KILL_SHARE[act - 1])])
			var boss := content.dungeon.acts[act - 1].boss
			xp += boss.xp_reward if boss else 0
	report.table("economy_levels", "Economy", "XP gathered before each act's boss (typical kills, measured XP per floor) and the level it gives (PlayerDef: %d x %.2f^(level-1) per level) vs the expected build's level" % [def.xp_to_next_level(1), def.xp_growth if "xp_growth" in def else 0.0],
		PackedStringArray(["Difficulty", "Act", "XP before the boss", "Level", "Expected build's level", "Kills assumed"]), rows)


func _level_for(xp: float) -> int:
	var level := 1
	var left := xp
	while level < 60 and left >= content.player.xp_to_next_level(level):
		left -= content.player.xp_to_next_level(level)
		level += 1
	return level


## Chances of each rarity for found equipment (LootRoller.pick_rarity) per depth and source.
func _loot_table(report: BalanceReport) -> void:
	var rows: Array = []
	var config := content.dungeon
	var sources := [["floor", 1.0], ["chest", config.chest.loot_quality if config.chest else 1.5], ["elite", config.elite_rank.loot_quality if config.elite_rank else 2.5],
		["merchant", config.merchant.quality if config.merchant else 2.0], ["boss", config.boss_loot_quality]]
	for depth in range(1, config.total_floors() + 1):
		for source: Array in sources:
			var q: float = source[1]
			var levels := depth - 1
			var weights := [config.common_weight, (config.magic_weight + config.magic_weight_per_depth * levels) * q,
				(config.rare_weight + config.rare_weight_per_depth * levels) * q, (config.epic_weight + config.epic_weight_per_depth * levels) * q]
			var total := 0.0
			for w: float in weights:
				total += w
			rows.append([depth, source[0], "%.1f" % q] + weights.map(func(w: float) -> String: return BalanceReport.pct(w / total)))
	report.table("economy_loot", "Economy", "Rarity of found equipment per depth and source (LootRoller.pick_rarity; DungeonConfig > Loot)",
		PackedStringArray(["Depth", "Source", "Quality", "Common", "Magic", "Rare", "Epic"]), rows, 30)


## Souls per run by result and difficulty vs the shrine.
func _souls_table(report: BalanceReport, per_depth: Array) -> void:
	var shrine_total := 0
	var cheapest := 1 << 30
	var upgrade_rows: Array = []
	for u in content.upgrades:
		var cost := 0
		for level in u.max_level:
			cost += u.cost_for_level(level)
			cheapest = mini(cheapest, u.cost_for_level(level))
		shrine_total += cost
		upgrade_rows.append([String(u.id), UpgradeDef.Kind.keys()[u.kind], u.max_level, u.cost_for_level(0), cost])
	report.table("shrine_costs", "Economy", "Shrine upgrades: levels and souls (total %d souls)" % shrine_total,
		PackedStringArray(["Upgrade", "Kind", "Levels", "First level", "All levels"]), upgrade_rows)
	var rows: Array = []
	var acts := content.dungeon.acts.size()
	for difficulty in difficulties:
		var d_key := BalanceContent.key(difficulty)
		var kills := 0.0
		var results := []
		for act in range(1, acts + 1):
			for p: Dictionary in per_depth:
				if p.difficulty == d_key and p.act == act:
					kills += p.kills_typical
			var boss_depth := BalanceContent.boss_depth(content, act)
			# Dies at the act's boss / wins it.
			results.append(["dies at the act %d boss" % act, Profile.souls_for_run(roundi(kills), boss_depth, act - 1, false, difficulty.souls)])
			kills += 1
		results.append(["wins the run", Profile.souls_for_run(roundi(kills), content.dungeon.total_floors(), acts, true, difficulty.souls)])
		var average := (float(results[1][1]) + float(results[2][1])) * 0.5  # dies in act II-III
		var runs := shrine_total / maxf(average, 1.0)
		for r: Array in results:
			rows.append([d_key, r[0], r[1], "%.1f" % (shrine_total / maxf(float(r[1]), 1.0))])
		if d_key == "normal" and not quick:  # (--quick measures two floors only)
			if runs < targets.runs_to_max_shrine_min or runs > targets.runs_to_max_shrine_max:
				report.flag(BalanceReport.WARN, "economy: souls", "runs to buy the whole shrine (normal, dying in act II-III)", "%.1f runs" % runs,
					"%.0f-%.0f" % [targets.runs_to_max_shrine_min, targets.runs_to_max_shrine_max], "%d souls in all, %.0f a run" % [shrine_total, average])
			if targets.first_run_buys_upgrade and int(results[0][1]) < cheapest:
				report.flag(BalanceReport.WARN, "economy: souls", "first run (normal, dies at the act I boss)", "%d souls" % results[0][1],
					">= %d (the cheapest level)" % cheapest, "a first run should buy something at the shrine")
	report.table("economy_souls", "Economy", "Souls per run (Profile.souls_for_run: kills, depth, bosses, win, x difficulty; typical kills measured; achievements, quests and bestiary ranks not counted) and runs of that kind to buy the whole shrine",
		PackedStringArray(["Difficulty", "Result", "Souls", "Runs to buy everything"]), rows)
