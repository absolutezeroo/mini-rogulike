[ext_resource type="Script" path="res://src/definitions/story_def.gd" id="1_22qmx"]

[resource]
script = ExtResource("1_22qmx")
tagline = "Descend. Bring back the stolen souls. Become what the dark demands."
intro_pages = PackedStringArray("Beneath the village of Kagari sleeps an old well.\nNo one draws water from it anymore.\nThe elders say it has no bottom: only a mouth.", "On a moonless night, the Well woke.\nA cold breath passed through every house, and put out every flame...\nAt dawn, the villagers slept, and would not wake.", "Their souls were gone: drawn down the Well, where the dead things feed.", "Only you were spared: the ninja keeping vigil at the shrine,\nthe shrine\'s lantern still burning in your hand.", "Its wardens guard the stolen souls, each one deeper in the dark than the last.", "Take up the lantern. Descend.\nEvery soul you bring back, the shrine turns into strength.\nSteel, sorcery or faith: become what the dark demands.")
victory_text = "The last warden falls. Its hoard of stolen souls breaks open,
and a river of light rises toward Kagari. The bell rings; the village wakes.
But the Well goes deeper still..."
death_lines = PackedStringArray("Your soul joins the others, deep in the Well.", "The lantern goes out... for now.", "The Well keeps you tonight. The shrine remembers the souls you brought back.", "Darkness. Then the shrine\'s bell, far above. Again.")
shrine_text = "The souls you brought back from the Well lend you their strength."
