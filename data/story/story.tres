[gd_resource type="Resource" script_class="StoryDef" format=3]

[ext_resource type="Script" path="res://src/definitions/story_def.gd" id="1_22qmx"]

[resource]
script = ExtResource("1_22qmx")
tagline = "Descend. Bring back the stolen souls. Become what the dark demands."
intro_pages = PackedStringArray("Beneath the village of Kagari sleeps an old well.\nThe shrine\'s lantern keeps watch over it, night and day.\nThe elders say it has no bottom: only a mouth.", "On a moonless night, the Well woke.\nA cold breath, and every flame lay down.\nAt dawn Kagari slept, and would not wake.", "Their souls were gone: drawn down the Well, where the dead things feed.", "Only you were spared, the keeper\'s pupil,\nthe shrine\'s lantern burning in your hand.\nOf your master, there was no trace.", "Dead things keep the stolen souls,\neach one deeper than the last,\nchained there by a hand no one saw.", "Take up the lantern. Descend.\nEvery soul you bring back, the shrine turns into strength.\nSteel, sorcery or faith: become what the dark demands.")
victory_text = "The last warden falls. Its hoard of stolen souls breaks open,
and a river of light rises toward Kagari. The bell rings; the village wakes.
But the Well goes deeper still..."
death_lines = PackedStringArray("Your soul joins the others, deep in the Well.", "The lantern goes out... for now.", "The Well keeps you tonight. The shrine remembers the souls you brought back.", "Darkness. Then the shrine\'s bell, far above. Again.")
shrine_text = "The souls you brought back from the Well lend you their strength."
