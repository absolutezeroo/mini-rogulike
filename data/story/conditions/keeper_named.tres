[gd_resource type="Resource" script_class="AnyCondition" format=3]

[ext_resource type="Script" path="res://src/definitions/story/conditions/any_condition.gd" id="1_anycondition"]
[ext_resource type="Script" path="res://src/definitions/story/conditions/all_condition.gd" id="2_allcondition"]
[ext_resource type="Resource" path="res://data/story/conditions/effigy_slain.tres" id="3_effigyslain"]
[ext_resource type="Resource" path="res://data/story/conditions/first_victory.tres" id="4_firstvictory"]
[ext_resource type="Script" path="res://src/definitions/story/progress_condition.gd" id="5_progresscond"]
[ext_resource type="Script" path="res://src/definitions/story/conditions/met_condition.gd" id="6_metcondition"]

[sub_resource type="Resource" id="Resource_1"]
script = ExtResource("2_allcondition")
conditions = Array[ExtResource("5_progresscond")]([ExtResource("3_effigyslain"), ExtResource("4_firstvictory")])
text = "Find the one who does not rest, then win a run"

[sub_resource type="Resource" id="Resource_2"]
script = ExtResource("6_metcondition")
monster_id = &"master_toma"
text = "Find the one who waits at the bottom"

[resource]
script = ExtResource("1_anycondition")
conditions = Array[ExtResource("5_progresscond")]([SubResource("Resource_1"), SubResource("Resource_2")])
text = "Find the one who does not rest, then win a run"
