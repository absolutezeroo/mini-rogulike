[resource]
script = ExtResource("1_finale")
id = &"well_bottom"
title = "The Well's Bottom"
subtitle = "The End of the Descent"
lore = "Below the kingdom of dust, the stone ends. Someone kneels in the dark, an unlit lantern in his hand."
victories_needed = 1
biome = ExtResource("2_biome")
arena = ExtResource("3_arena")
boss = ExtResource("4_boss")
arena_lights = 0
endings = Array[ExtResource("5_ending")]([ExtResource("6_bell"), ExtResource("7_keeper")])
choice_title = "What Is Left"
choice_lore = "The mask is dust. Your master stands in the dark, free, and looks at the lantern in your hand. Far above, the bell waits."
color = Color(0.78, 0.66, 1, 1)
