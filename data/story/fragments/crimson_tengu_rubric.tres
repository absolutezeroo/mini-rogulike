[resource]
script = ExtResource("1_fragmentdef")
id = &"crimson_tengu_rubric"
title = "Rubric of the Rite"
author = "A priest of Solhar"
place = "Carved in the Pyre Temple's wall"
lines = PackedStringArray("The priest takes no balm and no remedy while the offering burns.", "Whoever heals during the rite defiles it. Then the sun turns its face away.", "Burn without remedy, and the face will look upon you.")
look = ExtResource("2_singedpage")
