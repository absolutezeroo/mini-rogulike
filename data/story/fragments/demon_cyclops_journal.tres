[resource]
script = ExtResource("1_fragmentdef")
id = &"demon_cyclops_journal"
title = "Tôma's Journal, a Sooty Page"
author = "Tôma, keeper of the shrine"
place = "The Ossuary"
lines = PackedStringArray("Gorr looked at me with his one eye. He remembered my oath; I saw it.", "He took the souls without a word. He still believes my hand does not lie.", "Hana was afraid of him when she was small. He carved her a doll from an ox bone.")
look = ExtResource("3_keeperjourna")
conditions = Array[ExtResource("4_progresscond")]([ExtResource("2_keepernamed")])
