[resource]
script = ExtResource("1_fragmentdef")
id = &"giant_frog_journal"
title = "Tôma's Journal, a Wet Page"
author = "Tôma, keeper of the shrine"
place = "The spring, at dusk"
lines = PackedStringArray("She sings my daughter's name. She does not know what she sings.", "I gave her the children's souls to keep. Hana loved that frog.", "If the water gives my daughter back, I will give hers back. I swear it on the lantern.")
look = ExtResource("3_keeperjourna")
conditions = Array[ExtResource("4_progresscond")]([ExtResource("2_keepernamed")])
