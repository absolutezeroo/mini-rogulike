[resource]
script = ExtResource("1_fragmentdef")
id = &"king_slime_register"
title = "Register of Offerings"
author = "A sexton of the shrine"
place = "Kagari, the autumn before"
lines = PackedStringArray("The Nushi has grown again. It swallows the wax faster than we can pour it.", "Left in peace for a minute, it doubles. Drive it off at once, or not at all.", "The keeper says to let it be. The keeper knows what he does.")
look = ExtResource("2_villagescrap")
