[resource]
script = ExtResource("1_fragmentdef")
id = &"crimson_tengu_feather"
title = "A Written Feather"
author = "The Crimson Tengu"
place = "The Pyre Temple, east altar"
lines = PackedStringArray("Dawn, swept the ash. Three lost souls to the pyres.", "Dawn, swept the ash. A feather fell from me; it will not grow back.", "Dawn, swept the ash.")
