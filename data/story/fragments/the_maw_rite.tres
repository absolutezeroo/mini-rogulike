[resource]
script = ExtResource("1_fragmentdef")
id = &"the_maw_rite"
title = "The First Keeper's Rite"
author = "A knight with no name"
place = "A copy, taken from under the bell of Kagari"
lines = PackedStringArray("It does not die. A lack is not killed; it is made to wait.", "Ring the bell from below, and the door remembers it is a door.", "Give it nothing, not even a drop of blood. What it has tasted, it keeps.")
look = ExtResource("2_look")
conditions = Array[ExtResource("3_progresscond")]([SubResource("Resource_1")])
