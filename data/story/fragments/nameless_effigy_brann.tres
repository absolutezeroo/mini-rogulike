[resource]
script = ExtResource("1_fragmentdef")
id = &"nameless_effigy_brann"
title = "Brann's Note on Two Blades"
author = "Brann the Smith"
place = "Scratched on a cold blade's guard"
lines = PackedStringArray("Forged for a man going to die without a name. I did not want to know his.", "They will not tremble. Neither will he.", "Beat him without bleeding much, and he will speak to you. He was an upright man.")
look = ExtResource("3_bonetablet")
conditions = Array[ExtResource("4_progresscond")]([SubResource("Resource_1")])
