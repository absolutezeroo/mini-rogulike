[resource]
script = ExtResource("1_fragmentdef")
id = &"sun_wraith_templar"
title = "A Templar's Warning"
author = "A templar without an order"
place = "Carved on a slab of the tomb"
lines = PackedStringArray("Our prayers fed it; only our blessed steel wounds it.", "Strike it with the Templar's sword, and the mask cracks.", "I did not have the time. You, perhaps.")
