[resource]
script = ExtResource("1_fragmentdef")
id = &"nameless_effigy_epitaph"
title = "An Effaced Epitaph"
author = "A stonecutter"
place = "On a tomb without an inscription"
lines = PackedStringArray("Here lies —, knight of —, who gave his name to the seal.", "Passer-by, do not try to read it. The name is below, and it holds the door.")
look = ExtResource("3_bonetablet")
conditions = Array[ExtResource("4_progresscond")]([SubResource("Resource_1")])
