[resource]
script = ExtResource("1_fragmentdef")
id = &"master_toma_lessons"
title = "The Shrine's Fencing Lessons"
author = "Tôma, keeper of the shrine"
place = "Pinned inside the dojo's door"
lines = PackedStringArray("The dash: go in, strike, never stay where the answer will fall.", "The guard: do not step aside. Let it come, and be there when it does.", "The lantern: it never goes out. That rule I will not teach him to break.")
look = ExtResource("2_look")
conditions = Array[ExtResource("3_progresscond")]([ExtResource("4_keepernamed")])
