[resource]
script = ExtResource("1_fragmentdef")
id = &"red_samurai_roll"
title = "Roll of the Seventh Step"
author = "Vardan, temple guard"
place = "Solhar, the day of the Tithe"
lines = PackedStringArray("Merel the baker, and her two sons. Osk the tanner. Old Ilse, who brought me water.", "All went up at dawn. None came down.", "Order carried out.")
look = ExtResource("2_sealedletter")
