[resource]
script = ExtResource("1_fragmentdef")
id = &"the_maw_boat"
title = "A Paper Boat"
author = "Hana, in a child's hand"
place = "Found dry, in the tar"
lines = PackedStringArray("Little boat, go down to the bottom and say hello to the sun.", "Bring a ray back for papa. He is always cold.")
