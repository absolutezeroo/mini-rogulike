[resource]
script = ExtResource("1_fragmentdef")
id = &"weeping_spirit_journal"
title = "Tôma's Journal, a Folded Page"
author = "Tôma, keeper of the shrine"
place = "The Ossuary"
lines = PackedStringArray("They weep for Hana. No one asked them to; they do it anyway.", "I have no tears left. I left them my last ones, with the souls.", "When Hana comes back, I will pay them all the rice in the world.")
look = ExtResource("3_keeperjourna")
conditions = Array[ExtResource("4_progresscond")]([ExtResource("2_keepernamed")])
