[resource]
script = ExtResource("1_fragmentdef")
id = &"demon_cyclops_register"
title = "The Ossuary Register"
author = "Gorr, gravedigger"
place = "Ossuary of Kagari, niche forty"
lines = PackedStringArray("Niche thirty-eight: the old potter. He laughed loudly.", "Niche thirty-nine: the ferryman's wife, and her comb.", "Niche forty: empty. I am keeping it for myself.")
