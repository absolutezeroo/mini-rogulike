id = &"monster_rope"
lines = PackedStringArray("{act}, floor {floor}. {killer} sent you back to me, and I heard you climb the bell rope.")
conditions = Array[ExtResource("3_condition")]([SubResource("c1"), SubResource("c25")])
priority = 20
remembered = false

[sub_resource type="Resource" id="l_unknown"]
