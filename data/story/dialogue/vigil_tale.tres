[sub_resource type="Resource" id="l_elite"]
script = ExtResource("2_line")
id = &"elite"
lines = PackedStringArray("{killer}, ringed in light. The bell tolled deeper for that one.", "Floor {floor}, {biome}. I keep the names of the places where you fall, child.")
conditions = Array[ExtResource("3_condition")]([SubResource("c1"), SubResource("c20")])
priority = 32
remembered = false

