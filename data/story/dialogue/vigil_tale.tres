script = ExtResource("2_line")
id = &"monster"
lines = PackedStringArray("{killer}, floor {floor}, {biome}: I felt your flame waver, then nothing.")
conditions = Array[ExtResource("3_condition")]([SubResource("c1"), SubResource("c25")])
priority = 20
remembered = false

[sub_resource type="Resource" id="l_monster_level"]
script = ExtResource("2_line")
id = &"monster_level"
lines = PackedStringArray("You fell on floor {floor}, child, at level {level}, after {time} in the dark. {killer} was hungry.")
conditions = Array[ExtResource("3_condition")]([SubResource("c1"), SubResource("c25")])
priority = 20
remembered = false

[sub_resource type="Resource" id="l_monster_rope"]
