[sub_resource type="Resource" id="l_early"]
script = ExtResource("2_line")
id = &"early"
lines = PackedStringArray("So soon, child. The well-rim is still warm from your hand.", "{killer}, on floor {floor}. Come up, breathe, and go down again.")
conditions = Array[ExtResource("3_condition")]([SubResource("c1"), SubResource("c24")])
priority = 25
cooldown_runs = 2
remembered = false

