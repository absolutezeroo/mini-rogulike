kind = 4

[sub_resource type="Resource" id="l_ranged"]
script = ExtResource("2_line")
id = &"ranged"
lines = PackedStringArray("{killer}, from afar. You never saw the blow coming, child; I heard it whistle.")
conditions = Array[ExtResource("3_condition")]([SubResource("c1"), SubResource("c21")])
priority = 30
remembered = false

