kind = 0

[sub_resource type="Resource" id="l_crimson_tengu"]
script = ExtResource("2_line")
id = &"crimson_tengu"
lines = PackedStringArray("When the line of its step marks the ground, the Tengu is about to cross it in one stroke. Leave it sideways, child, then strike where it stops.")
conditions = Array[ExtResource("3_condition")]([SubResource("c1"), SubResource("c7")])
priority = 80
cooldown_runs = 2

