script = ExtResource("2_line")
id = &"gilded_hoarder"
lines = PackedStringArray("The Hoarder leaps along a line and crushes where he lands: step off his line.", "At half his life he calls his thieves; cut them down fast, child, they carry off your gold.")
conditions = Array[ExtResource("3_condition")]([SubResource("c1"), SubResource("c10")])
priority = 80
cooldown_runs = 2

