lines = PackedStringArray("Only the Jade Wyrm's head can be wounded; its coils burn. When the venom blooms all around it, child, be far away already.")
conditions = Array[ExtResource("3_condition")]([SubResource("c1"), SubResource("c9")])
priority = 80
cooldown_runs = 2

