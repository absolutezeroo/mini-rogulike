lines = PackedStringArray("The Dead Sun fades and appears elsewhere: never stand still before it. Its flare goes out in a ring; look for the gaps far from it, child.")
conditions = Array[ExtResource("3_condition")]([SubResource("c1"), SubResource("c11")])
priority = 80
cooldown_runs = 2

