lines = PackedStringArray("The Ronin's flame arc burns all around him, up close. Step out of the circle when he draws, child, and come back when the flame dies down.")
conditions = Array[ExtResource("3_condition")]([SubResource("c1"), SubResource("c8")])
priority = 80
cooldown_runs = 2

