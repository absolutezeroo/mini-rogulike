[sub_resource type="Resource" id="l_king_slime"]
script = ExtResource("2_line")
id = &"king_slime"
lines = PackedStringArray("The Bloated King spits its rain in a crown: stand between two drops, never in their line.", "And when it splits, child, cut the little ones down one by one.")
conditions = Array[ExtResource("3_condition")]([SubResource("c1"), SubResource("c2")])
priority = 80
cooldown_runs = 2

[sub_resource type="Resource" id="c3"]
script = ExtResource("6_killer_condi")
monster_ids = Array[StringName]([&"giant_frog"])
kind = 0

[sub_resource type="Resource" id="l_giant_frog"]
script = ExtResource("2_line")
id = &"giant_frog"
lines = PackedStringArray("The Matron leaps in a straight line and lands hard: step aside, not back.", "Her spit opens like a fan; go wide around it, child.")
conditions = Array[ExtResource("3_condition")]([SubResource("c1"), SubResource("c3")])
priority = 80
cooldown_runs = 2

[sub_resource type="Resource" id="c4"]
script = ExtResource("6_killer_condi")
