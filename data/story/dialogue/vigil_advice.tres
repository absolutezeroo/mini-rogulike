kind = 0

[sub_resource type="Resource" id="l_demon_cyclops"]
script = ExtResource("2_line")
id = &"demon_cyclops"
lines = PackedStringArray("Gorr's eye spits fire in a fan before him: keep to his flank.", "When the ground reddens in a wide circle, child, leave it before his club falls.")
conditions = Array[ExtResource("3_condition")]([SubResource("c1"), SubResource("c4")])
priority = 80
cooldown_runs = 2

[sub_resource type="Resource" id="c5"]
script = ExtResource("6_killer_condi")
monster_ids = Array[StringName]([&"azure_wyrm"])
kind = 0

[sub_resource type="Resource" id="l_azure_wyrm"]
script = ExtResource("2_line")
id = &"azure_wyrm"
lines = PackedStringArray("Only the Azure Wyrm's head bleeds; its body burns cold at a touch. When it dives along a line, roll across it, child, not along it.")
conditions = Array[ExtResource("3_condition")]([SubResource("c1"), SubResource("c5")])
priority = 80
cooldown_runs = 2

[sub_resource type="Resource" id="c6"]
script = ExtResource("6_killer_condi")
monster_ids = Array[StringName]([&"weeping_spirit"])
kind = 0

[sub_resource type="Resource" id="l_weeping_spirit"]
script = ExtResource("2_line")
id = &"weeping_spirit"
lines = PackedStringArray("The Mother of Tears' wail goes out in a ring, and the ring widens as it travels.", "Far from her the gaps are wider, child: that is where you pass.")
conditions = Array[ExtResource("3_condition")]([SubResource("c1"), SubResource("c6")])
priority = 80
cooldown_runs = 2

[sub_resource type="Resource" id="c7"]
script = ExtResource("6_killer_condi")
