[sub_resource type="Resource" id="Resource_1"]
script = ExtResource("3_huntchalleng")
id = &"healthy"
goal = 9
souls = 0
ratio = 0.25

[sub_resource type="Resource" id="Resource_2"]
script = ExtResource("4_challengedee")
id = &"steady_blade"
hint = "He only yields to a blade that does not tremble."
rule = "Slay him losing less than a quarter of your Health."
revealed_by = ExtResource("2_namelesseffi")
challenge = SubResource("Resource_1")

[sub_resource type="Resource" id="Resource_3"]
script = ExtResource("5_chroniclecha")
id = &"stone_knight"
title = "The Stone Knight"
lines = PackedStringArray("A stone knight, lying for centuries on a tomb with no inscription. He has risen.", "He murmurs names as he walks. None of them is his.")
slain = 0

[sub_resource type="Resource" id="Resource_4"]
script = ExtResource("5_chroniclecha")
id = &"the_cut"
title = "The Cut"
lines = PackedStringArray("The seal he guards has been cut. A clean cut, without hesitation, by a blade you know.", "It is the school of your shrine. The stroke you were taught, too.")
slain = 1

[sub_resource type="Resource" id="Resource_5"]
script = ExtResource("6_fragmentscon")
count = 2

[sub_resource type="Resource" id="Resource_6"]
script = ExtResource("5_chroniclecha")
id = &"foreign_blades"
title = "The Foreigner's Blades"
lines = PackedStringArray("His two cold blades were forged by a foreign smith, who wept as he tempered them.", "That smith still lives in the Well. He forges for others now, to be forgiven.")
slain = 1
conditions = Array[ExtResource("7_progresscond")]([SubResource("Resource_5")])

[sub_resource type="Resource" id="Resource_7"]
script = ExtResource("5_chroniclecha")
id = &"price_of_a_name"
title = "The Price of a Name"
lines = PackedStringArray("Long ago a knight went down to seal what hungers. Solhar claims him; others say he had no land at all.", "The seal asked a price. He gave his name, and the name became the seal.", "Since then he no longer knows what he was called. He tries the names of the dead, one by one.")
slain = 2
conditions = Array[ExtResource("7_progresscond")]([ExtResource("8_actiiireache")])

[sub_resource type="Resource" id="Resource_8"]
script = ExtResource("5_chroniclecha")
id = &"the_one_who_cut"
title = "The One Who Cut"
lines = PackedStringArray("The last keeper of Kagari came this far, his lantern unlit. The Effigy rose to stop him.", "He lost. The keeper cut the seal's last knot, then bound him to guard what he had sworn to prevent.", "The first keeper serves the last. He has no name left to curse it with.")
slain = 4

[sub_resource type="Resource" id="Resource_9"]
script = ExtResource("5_chroniclecha")
id = &"what_he_sealed"
title = "What He Sealed"
lines = PackedStringArray("He saw the Maw once, before he sealed it. It was no beast: it was a lack that had taken shape.", "The seal did not kill it. It made it wait, and it knows how to wait.", "Someone could close the door again: by giving him back his name, or by giving their own.")
slain = 6
conditions = Array[ExtResource("7_progresscond")]([SubResource("Resource_2")])

[sub_resource type="Resource" id="Resource_10"]
script = ExtResource("6_fragmentscon")
count = 1

[sub_resource type="Resource" id="Resource_11"]
script = ExtResource("9_wakingline")
id = &"what_was_i_called"
line = "You carry the lantern. I carried it too. Tell me... what was I called?"
conditions = Array[ExtResource("7_progresscond")]([SubResource("Resource_10")])

[sub_resource type="Resource" id="Resource_12"]
script = ExtResource("9_wakingline")
id = &"mine_in_the_seal"
line = "Tôma. I know his name. Mine he left in the seal, with the cut."
conditions = Array[ExtResource("7_progresscond")]([ExtResource("10_keepernamed")])

[resource]
script = ExtResource("1_bosschronicl")
chapters = Array[ExtResource("5_chroniclecha")]([SubResource("Resource_3"), SubResource("Resource_4"), SubResource("Resource_6"), SubResource("Resource_7"), SubResource("Resource_8"), SubResource("Resource_9")])
waking_lines = Array[ExtResource("9_wakingline")]([SubResource("Resource_11"), SubResource("Resource_12")])
fragments = Array[ExtResource("13_fragmentdef")]([ExtResource("11_namelesseffi"), ExtResource("2_namelesseffi"), ExtResource("12_namelesseffi")])
