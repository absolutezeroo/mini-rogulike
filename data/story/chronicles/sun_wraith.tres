[ext_resource type="Resource" path="res://data/story/fragments/sun_wraith_templar.tres" id="2_sunwraithtem"]
[ext_resource type="Resource" path="res://data/items/weapons/templar_sword.tres" id="3_templarsword"]
[ext_resource type="Script" path="res://src/definitions/hunt_challenge.gd" id="4_huntchalleng"]
[ext_resource type="Script" path="res://src/definitions/story/deeds/challenge_deed.gd" id="5_challengedee"]
[ext_resource type="Script" path="res://src/definitions/story/chronicle_chapter.gd" id="6_chroniclecha"]
[ext_resource type="Script" path="res://src/definitions/story/conditions/fragments_condition.gd" id="7_fragmentscon"]
[ext_resource type="Script" path="res://src/definitions/story/progress_condition.gd" id="8_progresscond"]
