[resource]
script = ExtResource("1_narrativedef")
full_cinematic = ExtResource("2_bossfull")
short_cinematic = ExtResource("3_bossshort")
fragment_chance = 0.35
fragments_open = Array[ExtResource("5_progresscond")]([ExtResource("4_fragmentsope")])
fragment_message = "A fragment of the past: %s."
deed_message = "The Well remembers how %s fell."
keeper_reveal = ExtResource("6_keepernamed")
reveal_words = PackedStringArray("Tôma", "Toma")
shrine_speaker = ExtResource("8_vigilkeeper")
shrine_dialogues = Array[ExtResource("7_dialoguedef")]([ExtResource("9_vigilshrine")])
death_dialogues = Array[ExtResource("7_dialoguedef")]([ExtResource("10_vigiltale"), ExtResource("11_vigiladvice")])
victory_dialogues = Array[ExtResource("7_dialoguedef")]([ExtResource("12_vigilvictor")])
dialogues = Array[ExtResource("7_dialoguedef")]([ExtResource("9_vigilshrine"), ExtResource("10_vigiltale"), ExtResource("11_vigiladvice"), ExtResource("12_vigilvictor"), ExtResource("13_wanderer"), ExtResource("14_smith"), ExtResource("15_spirit")])
