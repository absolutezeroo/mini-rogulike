[ext_resource type="Script" path="res://src/definitions/ending_def.gd" id="1_ending"]
[ext_resource type="AudioStream" path="res://assets/audio/music/lost_village.ogg" id="snd_lost_village"]

[resource]
script = ExtResource("1_ending")
id = &"take_his_place"
choice = "Take his place"
hint = "Become the keeper of the seal: nameless, down here, for as long as it holds."
title = "The Nameless Keeper"
text = "You take his place before the seal, and the Well forgets your face.
Tôma climbs toward the light, to wake the village and answer to it.
Below, a lantern keeps watch. No one will know who holds it."
stat = "ending_keeper"
color = Color(0.78, 0.66, 1, 1)
music = ExtResource("snd_lost_village")
