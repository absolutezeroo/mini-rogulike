[resource]
script = ExtResource("21_uckqf")
title = "Kingdom of Dust"
subtitle = "Act IV"
lore = "Beneath the pyres lies Solhar itself, under a sky of stone: a kingdom the dust swallowed whole. Its king still counts what he took. Souls, mostly."
