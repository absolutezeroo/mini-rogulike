[sub_resource type="Resource" id="lance"]
script = ExtResource("2_vfx_sheet_def")
texture = ExtResource("1_frost_lance")
frames = 2
orient = 1
directions = 16
fps = 8.0
loop = true

[sub_resource type="Resource" id="chill"]
script = ExtResource("3_on_hit_status")
