halo = true

[resource]
script = ExtResource("7_charged_attack_def")
id = &"stick"
display_name = "Glacial Lance"
description = "A great ice shard that shatters into a frost nova: enemies around are slowed."
charge_time = 1.0
move_speed_scale = 0.5
effects = Array[ExtResource("6_effect")]([SubResource("shard")])
