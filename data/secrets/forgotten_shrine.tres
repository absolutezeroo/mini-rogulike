[gd_resource type="Resource" script_class="SecretEncounterReward" format=3]

[ext_resource type="Script" path="res://src/definitions/secrets/secret_encounter_reward.gd" id="1_reward"]
[ext_resource type="Script" path="res://src/definitions/encounters/encounter_def.gd" id="2_def"]
[ext_resource type="Resource" path="res://data/encounters/blood_altar.tres" id="3_altar"]
[ext_resource type="Resource" path="res://data/encounters/warden_statue.tres" id="4_statue"]
[ext_resource type="Resource" path="res://data/encounters/spirit_spring.tres" id="5_spring"]

[resource]
script = ExtResource("1_reward")
