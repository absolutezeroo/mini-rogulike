[resource]
script = ExtResource("4_spbkl")
name = "expected_a3"
description = "Average hero at the act III boss (depth 9). ~1140 + 120 (Demon Cyclops) + 65% of ~2850 = ~3110 XP = level 11 (2604 needed, 3795 for 12): 10 perks (Blood awake). Two relics (Guardian Ring, War Banner). A Rare Lance (Brutal, Swift) with 2 sockets: Leech + Ember (by now ~7-8 runes were found: a Leech among them 2 times in 3). Iron helm and chain mail. Shrine: Vitality 3, Might 2, Toughness 1.
Level from the XP curve (PlayerDef: 20 x 1.45^(L-1) per level) and the XP lying on Normal floors (measured: ~163/202 XP on floors 1-2, 430/616 on 4-5, ~1450/1400 on 7-8, ~1790/1710 on 10-11, elites included), assuming the player kills ~80% of an act I floor, 75% in act II, 65% in act III, 60% in act IV (the seal asks 70%, at most 50 kills), plus the bosses' XP (60, 120, 200). Perks: one per level up (level - 1), leaning to families (family_bias 1). Relics: one per boss slain. Gear: Magic/Rare weights from DungeonConfig > Loot at that depth (boss drops x5 quality); runes: every boss drops one, elites 30%, so 3-4 runes by act II and a forge on ~30% of floors."
tags = PackedStringArray("expected")
act = 3
level = 11
weapon = ExtResource("5_i0qtu")
weapon_rarity = 2
weapon_affixes = PackedStringArray("brutal", "swift")
runes = PackedStringArray("leech_rune", "ember_rune")
armors = Array[ExtResource("1_ingtg")]([ExtResource("2_64pgb"), ExtResource("3_os2et")])
armor_rarities = PackedInt32Array(0, 0)
armor_affixes = PackedStringArray("", "")
perks = {
"frenzy": 2,
"guardian_ring": 1,
"iron_skin": 1,
"precision": 1,
"strength": 2,
"thunderclap": 1,
"vampirism": 1,
