[resource]
script = ExtResource("4_ttkvk")
name = "expected_a4"
description = "Average hero at the act IV boss (depth 12). ~3110 + 200 (Crimson Tengu) + 60% of ~3500 = ~5400 XP = level 13 (3795 needed, 5523 for 14): 12 perks. Three relics (Guardian Ring, War Banner, Executioner). A Rare Greatsword (Brutal, of the Fox) with Leech + Spark; Magic iron helm (Sturdy) and chain mail (of the Bear). Shrine: Vitality 3, Might 3, Toughness 2, Swiftness 1.
Level from the XP curve (PlayerDef: 20 x 1.45^(L-1) per level) and the XP lying on Normal floors (measured: ~163/202 XP on floors 1-2, 430/616 on 4-5, ~1450/1400 on 7-8, ~1790/1710 on 10-11, elites included), assuming the player kills ~80% of an act I floor, 75% in act II, 65% in act III, 60% in act IV (the seal asks 70%, at most 50 kills), plus the bosses' XP (60, 120, 200). Perks: one per level up (level - 1), leaning to families (family_bias 1). Relics: one per boss slain. Gear: Magic/Rare weights from DungeonConfig > Loot at that depth (boss drops x5 quality); runes: every boss drops one, elites 30%, so 3-4 runes by act II and a forge on ~30% of floors."
tags = PackedStringArray("expected")
act = 4
level = 13
weapon = ExtResource("5_l6s4l")
weapon_rarity = 2
weapon_affixes = PackedStringArray("brutal", "of_the_fox")
runes = PackedStringArray("leech_rune", "spark_rune")
armors = Array[ExtResource("1_7sa60")]([ExtResource("2_1tpmf"), ExtResource("3_f03by")])
armor_rarities = PackedInt32Array(1, 1)
armor_affixes = PackedStringArray("sturdy", "of_the_bear")
perks = {
"executioner": 1,
"frenzy": 2,
"guardian_ring": 1,
"iron_skin": 1,
"precision": 1,
"strength": 3,
"thunderclap": 1,
"vampirism": 1,
"vitality": 3,
"war_banner": 1
}
upgrades = {
"might": 3,
"swiftness": 1,
"toughness": 2,
"vitality": 3
}
