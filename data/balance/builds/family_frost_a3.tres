[resource]
script = ExtResource("1")
name = "family_frost_a3"
description = "The Frost family built on purpose at the act III boss: expected_a3's level, armor and shrine, a Rare Lance (brutal, swift) with the family's runes (rime_rune, shatter_rune), and 10 perks leaning on the family (3+ pieces awake): frostbite, cold_snap, ice_shards, iron_skin, frenzy, precision, strength, guardian_ring, war_banner. Compared with the other family builds and expected_a3 (pillar 3: builds, not piles; pillar 4: comparable families)."
tags = PackedStringArray("family", "frost")
act = 3
level = 11
weapon = ExtResource("3")
