[resource]
script = ExtResource("4_q5k1b")
name = "expected_a2"
description = "Average hero at the act II boss (depth 6). 290 + 60 (King Slime) + 75% of 430 + 616 = ~1140 XP = level 9 (824 needed, 1215 for 10): 8 perks; Strength, Vitality and Vampirism together wake the Blood family (the offers lean to started families). One relic from the act I boss (Guardian Ring). A Rare Katana (Sharp, Swift): the King Slime drops 3 items at x5 quality (~15% Rare each). One Ember rune set (3-4 runes found by now, Leech is 1 in 8). Leather cap and armor. Shrine: Vitality 2, Might 1, Toughness 1.
Level from the XP curve (PlayerDef: 20 x 1.45^(L-1) per level) and the XP lying on Normal floors (measured: ~163/202 XP on floors 1-2, 430/616 on 4-5, ~1450/1400 on 7-8, ~1790/1710 on 10-11, elites included), assuming the player kills ~80% of an act I floor, 75% in act II, 65% in act III, 60% in act IV (the seal asks 70%, at most 50 kills), plus the bosses' XP (60, 120, 200). Perks: one per level up (level - 1), leaning to families (family_bias 1). Relics: one per boss slain. Gear: Magic/Rare weights from DungeonConfig > Loot at that depth (boss drops x5 quality); runes: every boss drops one, elites 30%, so 3-4 runes by act II and a forge on ~30% of floors."
tags = PackedStringArray("expected")
act = 2
level = 9
weapon = ExtResource("5_mwkwn")
weapon_rarity = 2
weapon_affixes = PackedStringArray("sharp", "swift")
runes = PackedStringArray("ember_rune")
armors = Array[ExtResource("1_sgugy")]([ExtResource("2_umvj2"), ExtResource("3_v57u5")])
armor_rarities = PackedInt32Array(0, 0)
armor_affixes = PackedStringArray("", "")
perks = {
"frenzy": 1,
"guardian_ring": 1,
"iron_skin": 1,
"precision": 1,
"strength": 2,
"vampirism": 1,
"vitality": 2
}
upgrades = {
