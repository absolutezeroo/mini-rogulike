[resource]
script = ExtResource("1")
name = "family_arcane_a3"
description = "The Arcane family built on purpose at the act III boss: expected_a3's level, armor and shrine, a Rare Magic Wand (of_sorcery, of_haste) with the family's runes (echo_rune, prism_rune), and 10 perks leaning on the family (3+ pieces awake): arcane_focus, arcane_power, devotion, echo, precision, strength, vitality, sages_codex, multishot. Compared with the other family builds and expected_a3 (pillar 3: builds, not piles; pillar 4: comparable families)."
tags = PackedStringArray("family", "arcane")
act = 3
level = 11
weapon = ExtResource("3")
weapon_rarity = 2
weapon_affixes = PackedStringArray("of_sorcery", "of_haste")
