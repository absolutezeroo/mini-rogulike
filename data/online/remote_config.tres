[gd_resource type="Resource" script_class="RemoteConfigDef" format=3]

[ext_resource type="Script" path="res://src/definitions/online/remote_config_def.gd" id="1_config"]
[ext_resource type="Script" path="res://src/definitions/online/remote_key_def.gd" id="2_key"]

[sub_resource type="Resource" id="enemy_health_easy"]
script = ExtResource("2_key")
key = "enemy_health_easy"
kind = 0
hook = 0
difficulty = &"easy"
default_number = 1.0
min_number = 0.5
max_number = 2.0
purpose = "Multiplies every monster's and boss's Health in Pilgrim runs (DifficultyDef monster_hp and boss_hp, through FloorRules). 1 = the data's. A hotfix: real changes go into data/difficulties/easy.tres."

[sub_resource type="Resource" id="enemy_health_normal"]
