[sub_resource type="Resource" id="Resource_q3krr"]
script = ExtResource("2_p8yni")
weight = 50
text = "The stone warms under your hand. An old keeper lends you his strength."
color = Color(1, 0.81960785, 0.4, 1)
gift = 1

[sub_resource type="Resource" id="Resource_fyttb"]
script = ExtResource("2_p8yni")
weight = 50
text = "Its eyes glow red. The dead of the Well answer in its place."
color = Color(1, 0.41960785, 0.41960785, 1)
monsters = 2
elite_monsters = true

[sub_resource type="Resource" id="Resource_dux4h"]
script = ExtResource("1_fgadc")
label = "Kneel"
outcomes = Array[ExtResource("2_p8yni")]([SubResource("Resource_q3krr"), SubResource("Resource_fyttb")])

[sub_resource type="Resource" id="Resource_niche"]
script = ExtResource("6_niche")
text = "Beside it, a niche cut for one more keeper stands empty. On its base a name has been scratched away; one line is left: \"He keeps the last flame.\""
revealed_text = "The niche of the last keeper, still empty. Under the scratches you can read the name now: Tôma. \"He keeps the last flame.\" He left it in your hands."
reveal = ExtResource("7_named")

[resource]
script = ExtResource("5_grvuo")
choices = Array[ExtResource("1_fgadc")]([SubResource("Resource_dux4h")])
verb = "Kneel"
id = &"warden_statue"
display_name = "Keeper's Statue"
description = "A statue of one of the shrine's old keepers, a stone lantern in hand. Its eyes follow you."
icon = ExtResource("4_31cle")
niche = SubResource("Resource_niche")
color = Color(0.72156864, 0.76862746, 0.8392157, 1)
min_depth = 2
spawn_weight = 7
