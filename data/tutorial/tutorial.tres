[gd_resource type="Resource" script_class="TutorialDef" format=3]

[ext_resource type="Script" path="res://src/definitions/tutorial_def.gd" id="1_tutorial"]
[ext_resource type="Script" path="res://src/definitions/hint_def.gd" id="2_hint"]

[sub_resource type="Resource" id="Hint_move"]
script = ExtResource("2_hint")
id = &"move"
cue = &"run_start"
title = "Move"
text = "Drag your thumb on the left side of the screen to walk."
target = &"Joystick"
done_when = &"moved"
duration = 0.0
priority = 10

[sub_resource type="Resource" id="Hint_seal"]
script = ExtResource("2_hint")
id = &"seal"
after = &"move"
only_if = &"sealed"
title = "Sealed stairs"
text = "The way down is sealed. Slay monsters to break the seal: the count is under the map."
target = &"SealLabel"
duration = 9.0

[sub_resource type="Resource" id="Hint_attack"]
script = ExtResource("2_hint")
id = &"attack"
cue = &"monster_noticed"
after = &"move"
title = "Attack"
text = "Hold the big button to strike. It aims at the closest enemy by itself."
target = &"AttackButton"
done_when = &"attacked"
duration = 20.0
priority = 9

[sub_resource type="Resource" id="Hint_roll"]
script = ExtResource("2_hint")
id = &"roll"
after = &"attack"
title = "Roll"
text = "Tap Roll to dash the way you walk. Nothing can hurt you mid-roll."
target = &"Skill1Button"
done_when = &"rolled"
duration = 15.0
priority = 9

[sub_resource type="Resource" id="Hint_weapon_skills"]
script = ExtResource("2_hint")
id = &"weapon_skills"
after = &"roll"
only_if = &"has_weapon_skill"
title = "Weapon skills"
text = "Your weapon has two skills of its own, and every weapon has different ones. Try them!"
target = &"Skill2Button"
done_when = &"weapon_skill"
duration = 15.0
priority = 9

[sub_resource type="Resource" id="Hint_potion"]
script = ExtResource("2_hint")
id = &"potion"
cue = &"low_health"
only_if = &"has_belt_item"
title = "Low health"
text = "Tap a potion on your belt to drink it. Potions are rare: keep them for when it counts."
target = &"QuickItemButton"
done_when = &"used_item"
duration = 12.0
priority = 8

[sub_resource type="Resource" id="Hint_souls"]
script = ExtResource("2_hint")
id = &"souls"
cue = &"monster_killed"
after = &"attack"
title = "Souls"
text = "Slain monsters free their souls. Between runs, spend them at the shrine for lasting upgrades."
target = &"SoulsLabel"
duration = 9.0

[sub_resource type="Resource" id="Hint_perks"]
script = ExtResource("2_hint")
id = &"perks"
cue = &"perk_chosen"
title = "Perks"
text = "Each level brings a perk. Three perks of one family awaken a bonus. See yours in the Bag, under Perks."
duration = 10.0

[sub_resource type="Resource" id="Hint_synergy"]
script = ExtResource("2_hint")
id = &"synergy"
cue = &"synergy"
title = "Family bonus"
text = "Three of a family: its bonus is yours for the rest of the run."
duration = 8.0

[sub_resource type="Resource" id="Hint_gear"]
script = ExtResource("2_hint")
id = &"gear"
cue = &"gear_carried"
title = "New gear"
text = "You picked up gear. Open the Bag to compare it and equip it."
target = &"BagButton"
done_when = &"opened_bag"
duration = 12.0

[sub_resource type="Resource" id="Hint_spell"]
script = ExtResource("2_hint")
id = &"spell"
cue = &"spell_learned"
title = "Spell"
text = "The tome taught you a spell: it has its own button. Reading another tome replaces it."
target = &"Skill4Button"
duration = 10.0

[sub_resource type="Resource" id="Hint_elite"]
script = ExtResource("2_hint")
id = &"elite"
cue = &"elite_noticed"
title = "Elite"
text = "Elites have powers, named after them. Tougher, but they drop better loot, and sometimes runes."
duration = 9.0

[sub_resource type="Resource" id="Hint_rune"]
script = ExtResource("2_hint")
id = &"rune"
cue = &"rune_carried"
title = "Rune"
text = "Runes go into your weapon's sockets at a smith's forge. Better weapons have more sockets."
duration = 10.0

[sub_resource type="Resource" id="Hint_forge"]
script = ExtResource("2_hint")
id = &"forge"
cue = &"forge_near"
title = "The forge"
text = "Walk up to the anvil to set runes into your weapon. The smith takes them out again for gold."
duration = 10.0

[sub_resource type="Resource" id="Hint_merchant"]
script = ExtResource("2_hint")
id = &"merchant"
cue = &"merchant_near"
title = "Merchant"
text = "Walk up to the merchant to spend your gold, or to sell him what you don't need."
duration = 10.0

[sub_resource type="Resource" id="Hint_chest"]
script = ExtResource("2_hint")
id = &"chest"
cue = &"chest_near"
title = "Chest"
text = "Walk up to a chest to open it. Careful: some are trapped."
duration = 8.0

[sub_resource type="Resource" id="Hint_ambush"]
script = ExtResource("2_hint")
id = &"ambush"
cue = &"ambush"
title = "Ambush"
text = "The exits stay shut until every wave is dead. Survive, and a chest appears."
duration = 9.0
priority = 6

[sub_resource type="Resource" id="Hint_boss"]
script = ExtResource("2_hint")
id = &"boss"
cue = &"boss_started"
title = "Boss"
text = "Watch the ground: red marks show where it will strike. It changes its attacks as it weakens."
duration = 10.0
priority = 7

[sub_resource type="Resource" id="Hint_stairs_open"]
script = ExtResource("2_hint")
id = &"stairs_open"
cue = &"seal_broken"
title = "Stairs open"
text = "Find the stairs on the map. Tap the map to see the whole floor."
target = &"Minimap"
duration = 9.0

[sub_resource type="Resource" id="Hint_cursed_floor"]
script = ExtResource("2_hint")
id = &"cursed_floor"
cue = &"cursed_floor"
title = "Cursed floor"
text = "A curse changes this floor's rules. It lasts until you take the stairs."
duration = 9.0

[sub_resource type="Resource" id="Hint_floor_event"]
script = ExtResource("2_hint")
id = &"floor_event"
cue = &"event_floor"
title = "Strange floor"
text = "Something unusual is going on here: the log on the left tells you what."
duration = 9.0

[sub_resource type="Resource" id="Hint_cold"]
script = ExtResource("2_hint")
id = &"cold"
cue = &"cold"
title = "Cold"
text = "Stay near a campfire to warm up. Frozen, you slow down and get hurt."
duration = 9.0
priority = 5

[sub_resource type="Resource" id="Hint_hot"]
script = ExtResource("2_hint")
id = &"hot"
cue = &"hot"
title = "Heat"
text = "Stay by an oasis to cool down before the heat hurts you."
duration = 9.0
priority = 5

[resource]
script = ExtResource("1_tutorial")
hints = Array[ExtResource("2_hint")]([SubResource("Hint_move"), SubResource("Hint_seal"), SubResource("Hint_attack"), SubResource("Hint_roll"), SubResource("Hint_weapon_skills"), SubResource("Hint_potion"), SubResource("Hint_souls"), SubResource("Hint_perks"), SubResource("Hint_synergy"), SubResource("Hint_gear"), SubResource("Hint_spell"), SubResource("Hint_elite"), SubResource("Hint_rune"), SubResource("Hint_forge"), SubResource("Hint_merchant"), SubResource("Hint_chest"), SubResource("Hint_ambush"), SubResource("Hint_boss"), SubResource("Hint_stairs_open"), SubResource("Hint_cursed_floor"), SubResource("Hint_floor_event"), SubResource("Hint_cold"), SubResource("Hint_hot")])
