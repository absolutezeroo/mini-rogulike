# Godot cache and imports (regenerated automatically)
.godot/
*.tmp

# Exports
/build/
/android/
*.apk
*.aab

# Signing keys: never in git
*.keystore
*.jks

# Local agent worktrees and tools
/.claude/worktrees/
/.claude/.gdignore
/_tool/

# Compiled translations (made from locale/strings.csv on import)
/locale/*.translation
